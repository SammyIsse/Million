# Staging / lokal native (matcher apps/mobile/.env)
EXPO_PUBLIC_FLAVOR=staging
# Simulator: http://localhost:5001
# Telefon (samme Wi-Fi): http://<mac-lan-ip>:5001  el. https://madshopper.dk
EXPO_PUBLIC_API_BASE_URL=http://localhost:5001
EXPO_PUBLIC_RPC_SUFFIX=_dev
EXPO_PUBLIC_SUPABASE_URL=https://oxzxingkbsnqzpmjtktr.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Web Client ID (token-verifikations-audience)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Native iOS/Android OAuth-klienter til GoogleSignin — se docs/env-setup.md §2
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Produktion (store-build / eas.json profile "production"):
# EXPO_PUBLIC_FLAVOR=production
# EXPO_PUBLIC_API_BASE_URL=https://madshopper.dk
# EXPO_PUBLIC_RPC_SUFFIX=
# Sæt også som EAS secrets (ikke i git): samme Supabase URL + anon-nøgle.
# EAS_PROJECT_ID sættes af `eas init`.
