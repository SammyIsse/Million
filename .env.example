# Lokal udvikling
FLASK_DEBUG=1
PORT=5001

# Prishistorik (Supabase price_history, 30 dage). Standard: slået til.
# ENABLE_PRICE_DB=1   # tving til
# ENABLE_PRICE_DB=0   # slå fra - appen kører uden prishistorik/favoritter

NEXT_PUBLIC_SUPABASE_URL=https://oxzxingkbsnqzpmjtktr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Jt8N0XezmzfZJSzzSwBBKQ_uGbNoq8f

# Skrive-tabeller (cart_popularity, price_alerts): lokal kørsel bruger
# automatisk *_dev-kopierne (scripts/supabase-dev-tables.sql), så test ikke
# rører produktionsdata. Sæt TABLE_SUFFIX= (tom) for bevidst at ramme prod.
# TABLE_SUFFIX=_dev

# Scrapers (kun nødvendigt lokalt / i GitHub secrets)
# DEPLOY_KEY=

# Valgfrit, snævrere login til KUN scraperne (scraper/supabase_utils.py).
# DEPLOY_KEY er service_role og omgår al RLS - langt mere adgang end en
# scraper skal bruge (skriver kun til produkter-tabellen). Opret en
# dedikeret Supabase Auth-bruger (Authentication → Users → Add user) og kør
# scripts/supabase-scraper-account.sql, som låser den brugers adgang til
# netop produkter via RLS - samme mønster som carts/price_alerts allerede
# bruger (compliance-audit 19-08-2026, GDPR-030; en oprindelig plan om en
# indsnævret nøgle/rolle med selvsigneret JWT måtte opgives 21-08-2026, da
# Supabase skiftede til asymmetrisk JWT-signering uden delt hemmelighed).
# Sæt begge som GitHub-secrets. Uden dem falder scraperne automatisk tilbage
# til SUPABASE_KEY/DEPLOY_KEY som i dag - intet ændrer sig før kontoen findes.
# SCRAPER_EMAIL=
# SCRAPER_PASSWORD=

# Deploy (kun nødvendigt lokalt, for at scripts/deploy-worker.sh kan purge
# Cloudflares CDN-cache automatisk efter hver deploy)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Feedback-siden sender hver besked videre til et Google Sheet via en Apps
# Script-webhook (URL'en fra "Deploy > New deployment > Web app"). På produktion
# lægges beskeder midlertidigt i Cloudflare D1 og sendes til arket via GitHub Actions.
# GOOGLE_SHEET_WEBHOOK_URL=
